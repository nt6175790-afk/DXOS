generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                   @id @default(uuid()) @db.Char(36)
  email         String                   @unique @db.VarChar(320)
  displayName   String?                  @map("display_name") @db.VarChar(200)
  passwordHash  String?                  @map("password_hash") @db.VarChar(255)
  accountStatus UserAccountStatus        @default(ACTIVE) @map("account_status")
  lastLoginAt   DateTime?                @map("last_login_at") @db.DateTime(6)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.DateTime(6)
  memberships   OrganizationMembership[]
  authSessions  AuthSession[]
  auditEvents   AuditEvent[]
  employees     Employee[]
  oidcIdentities OidcIdentity[]

  @@map("users")
}

enum UserAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Explicitly provisioned federation mapping. Never auto-link by email or roles.
model OidcIdentity {
  id        String @id @default(uuid()) @db.Char(36)
  userId    String @map("user_id") @db.Char(36)
  issuer    String @db.VarChar(191)
  subject   String @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("oidc_identities")
}

model OidcLoginAttempt {
  stateHash String @id @map("state_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.DateTime(6)

  @@index([expiresAt])
  @@map("oidc_login_attempts")
}

model AuthSession {
  id               String   @id @default(uuid()) @db.Char(36)
  userId           String   @map("user_id") @db.Char(36)
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime @map("expires_at") @db.DateTime(6)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Organization {
  attendanceLocation AttendanceLocation?
  id          String                   @id @default(uuid()) @db.Char(36)
  slug        String                   @unique @db.VarChar(63)
  name        String                   @db.VarChar(200)
  status      OrganizationStatus       @default(ACTIVE)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.DateTime(6)
  memberships OrganizationMembership[]
  departments Department[]
  roles       Role[]
  auditEvents AuditEvent[]
  employees   Employee[]
  tasks       Task[]
  leaveRequests LeaveRequest[]
  attendanceRecords AttendanceRecord[]
  shifts Shift[]
  workSchedules WorkSchedule[]
  approvalRequests ApprovalRequest[]
  compensationProfiles CompensationProfile[]
  payrollPeriods PayrollPeriod[]
  payrollRecords PayrollRecord[]
  performanceReviewCycles PerformanceReviewCycle[]
  performanceGoals        PerformanceGoal[]
  performanceKpis         PerformanceKpi[]
  performanceReviews      PerformanceReview[]
  employeeDocuments       EmployeeDocument[]
  documentRequirements    DocumentRequirement[]
  automationRules         AutomationRule[]
  automationExecutions    AutomationExecution[]
  workflowDefinitions     WorkflowDefinition[]
  workflowInstances       WorkflowInstance[]
  workflowStepExecutions  WorkflowStepExecution[]

  @@map("organizations")
}

model AttendanceLocation {
  organizationId String @id @map("organization_id") @db.Char(36)
  label String @db.VarChar(120)
  latitude Float @db.Double
  longitude Float @db.Double
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("attendance_locations")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  userId         String       @map("user_id") @db.Char(36)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments MembershipRole[] @relation("MembershipRoleMembership")
  notifications Notification[]
  files FileObject[]
  aiRequests AiRequest[]
  employee Employee?
  aiTaskDrafts AiTaskDraft[]
  aiKnowledgeDocuments AiKnowledgeDocument[]
  taskComments TaskComment[]
  taskAttachments TaskAttachment[]
  calendarEvents CalendarEvent[]
  createdLeaveRequests LeaveRequest[] @relation("LeaveCreatorMembership")
  reviewedLeaveRequests LeaveRequest[] @relation("LeaveReviewerMembership")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([userId, status, organizationId])
  @@index([organizationId, createdAt])
  @@map("organization_memberships")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

model CalendarEvent {
  id String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  createdByUserId String @map("created_by_user_id") @db.Char(36)
  title String @db.VarChar(200)
  description String? @db.VarChar(4000)
  kind CalendarEventKind
  startsAt DateTime @map("starts_at") @db.DateTime(3)
  endsAt DateTime @map("ends_at") @db.DateTime(3)
  location String? @db.VarChar(200)
  status CalendarEventStatus @default(SCHEDULED)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  creatorMembership OrganizationMembership @relation(fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict, map: "calendar_creator_membership_fk")
  leaveRequests LeaveRequest[]

  @@unique([organizationId, id])
  @@index([organizationId, createdByUserId])
  @@index([organizationId, startsAt, id], map: "calendar_org_start_idx")
  @@index([organizationId, endsAt], map: "calendar_org_end_idx")
  @@map("calendar_events")
}

enum CalendarEventKind {
  EVENT
  MEETING
}

enum CalendarEventStatus {
  SCHEDULED
  CANCELLED
}

model Department {
  id                 String       @id @default(uuid()) @db.Char(36)
  organizationId     String       @map("organization_id") @db.Char(36)
  parentDepartmentId String?      @map("parent_department_id") @db.Char(36)
  code               String       @db.VarChar(64)
  name               String       @db.VarChar(200)
  description        String?      @db.VarChar(1000)
  status             DepartmentStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent             Department?  @relation("DepartmentHierarchy", fields: [organizationId, parentDepartmentId], references: [organizationId, id], onDelete: Restrict)
  children           Department[] @relation("DepartmentHierarchy")
  employees          Employee[]
  tasks              Task[]
  documentRequirements DocumentRequirement[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, parentDepartmentId])
  @@map("departments")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

model Employee {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  userId         String         @map("user_id") @db.Char(36)
  departmentId   String?        @map("department_id") @db.Char(36)
  employeeCode   String         @map("employee_code") @db.VarChar(64)
  displayName    String         @map("display_name") @db.VarChar(200)
  jobTitle       String?        @map("job_title") @db.VarChar(200)
  phone          String?        @db.VarChar(16)
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  department     Department?    @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdTasks   Task[]         @relation("TaskCreator")
  assignedTasks  Task[]         @relation("TaskAssignee")
  reviewAssignments TaskReviewer[]
  leaveRequests LeaveRequest[] @relation("EmployeeLeaveRequests")
  attendanceRecords AttendanceRecord[] @relation("EmployeeAttendanceRecords")
  workSchedules WorkSchedule[] @relation("EmployeeWorkSchedules")
  requesterApprovals ApprovalRequest[] @relation("RequesterApprovals")
  reviewerApprovals ApprovalRequest[] @relation("ReviewerApprovals")
  compensationProfiles CompensationProfile[]
  payrollApprovedPeriods PayrollPeriod[] @relation("PayrollApprovedBy")
  payrollFinalizedPeriods PayrollPeriod[] @relation("PayrollFinalizedBy")
  payrollRecords PayrollRecord[]
  performanceReviews      PerformanceReview[] @relation("PerformanceReviewEmployee")
  reviewedReviews         PerformanceReview[] @relation("PerformanceReviewReviewer")
  performanceGoals        PerformanceGoal[]   @relation("PerformanceGoalEmployee")
  performanceKpis         PerformanceKpi[]    @relation("PerformanceKpiEmployee")
  documents               EmployeeDocument[]

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeCode])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([organizationId, departmentId])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model Task {
  id                 String       @id @default(uuid()) @db.Char(36)
  organizationId     String       @map("organization_id") @db.Char(36)
  creatorEmployeeId  String       @map("creator_employee_id") @db.Char(36)
  assigneeEmployeeId String?      @map("assignee_employee_id") @db.Char(36)
  departmentId       String?      @map("department_id") @db.Char(36)
  title              String       @db.VarChar(200)
  description        String?      @db.VarChar(10000)
  status             TaskStatus   @default(TODO)
  progressPercent    Int          @default(0) @map("progress_percent") @db.UnsignedTinyInt
  priority           TaskPriority @default(MEDIUM)
  dueAt              DateTime?    @map("due_at") @db.DateTime(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator            Employee     @relation("TaskCreator", fields: [organizationId, creatorEmployeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignee           Employee?    @relation("TaskAssignee", fields: [organizationId, assigneeEmployeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  department         Department?  @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  comments           TaskComment[]
  attachments        TaskAttachment[]
  checklist          TaskChecklistItem[]
  reviewer           TaskReviewer?
  aiDrafts           AiTaskDraft[]

  @@unique([organizationId, id])
  @@index([organizationId, creatorEmployeeId])
  @@index([organizationId, assigneeEmployeeId, id])
  @@index([organizationId, departmentId, id])
  @@index([organizationId, status, id])
  @@index([organizationId, priority, id])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model TaskChecklistItem {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  taskId         String   @map("task_id") @db.Char(36)
  title          String   @db.VarChar(200)
  isCompleted    Boolean  @default(false) @map("is_completed")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  task           Task     @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, taskId, createdAt, id], map: "task_checklist_chronology_idx")
  @@map("task_checklist_items")
}

model TaskReviewer {
  taskId         String   @id @map("task_id") @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  employeeId     String   @map("employee_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  task           Task     @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  employee       Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, taskId])
  @@index([organizationId, employeeId])
  @@map("task_reviewers")
}

model TaskComment {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  taskId         String   @map("task_id") @db.Char(36)
  authorUserId   String   @map("author_user_id") @db.Char(36)
  body           String   @db.VarChar(4000)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  task           Task     @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  authorMembership OrganizationMembership @relation(fields: [organizationId, authorUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, taskId, createdAt, id], map: "task_comments_chronology_idx")
  @@index([organizationId, authorUserId], map: "task_comments_author_idx")
  @@map("task_comments")
}

model TaskAttachment {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  taskId         String   @map("task_id") @db.Char(36)
  fileId         String   @map("file_id") @db.Char(36)
  linkedByUserId String   @map("linked_by_user_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  task           Task     @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  file           FileObject @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  linkerMembership OrganizationMembership @relation(fields: [organizationId, linkedByUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, taskId, fileId], map: "task_attachments_task_file_key")
  @@index([organizationId, taskId, createdAt, id], map: "task_attachments_chronology_idx")
  @@index([organizationId, fileId], map: "task_attachments_file_idx")
  @@index([organizationId, linkedByUserId], map: "task_attachments_linker_idx")
  @@map("task_attachments")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Role {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  key            String       @db.VarChar(100)
  name           String       @db.VarChar(150)
  description    String?      @db.VarChar(500)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissionAssignments RolePermission[]
  membershipAssignments MembershipRole[] @relation("MembershipRoleRole")

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(150)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  roleAssignments RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Char(36)
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id             String                 @id @default(uuid()) @db.Char(36)
  organizationId String                 @map("organization_id") @db.Char(36)
  membershipId   String                 @map("membership_id") @db.Char(36)
  roleId         String                 @map("role_id") @db.Char(36)
  createdAt      DateTime               @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.DateTime(6)
  membership     OrganizationMembership @relation("MembershipRoleMembership", fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  role           Role                   @relation("MembershipRoleRole", fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([organizationId, membershipId])
  @@index([organizationId, roleId])
  @@map("membership_roles")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String?       @map("organization_id") @db.Char(36)
  actorUserId    String?       @map("actor_user_id") @db.Char(36)
  event          String        @db.VarChar(100)
  resourceType   String        @map("resource_type") @db.VarChar(40)
  resourceId     String?       @map("resource_id") @db.Char(36)
  outcome        AuditOutcome
  source         AuditSource
  requestId      String?       @map("request_id") @db.VarChar(128)
  metadata       Json
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([organizationId, event, createdAt, id])
  @@index([actorUserId])
  @@map("audit_events")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum AuditSource {
  HTTP
  SYSTEM
}

model Notification {
  id String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  recipientUserId String @map("recipient_user_id") @db.Char(36)
  type String @db.VarChar(100)
  title String @db.VarChar(200)
  body String @db.VarChar(1000)
  metadata Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  readAt DateTime? @map("read_at") @db.DateTime(6)
  recipientMembership OrganizationMembership @relation(fields: [organizationId, recipientUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict, map: "notifications_recipient_membership_fkey")

  @@index([organizationId, recipientUserId, createdAt, id], map: "notifications_recipient_chronology_idx")
  @@index([organizationId, recipientUserId, readAt, createdAt, id], map: "notifications_recipient_read_chronology_idx")
  @@map("notifications")
}

model FileObject {
  id String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  uploadedByUserId String @map("uploaded_by_user_id") @db.Char(36)
  originalFilename String @map("original_filename") @db.VarChar(200)
  contentType String @map("content_type") @db.VarChar(100)
  size Int? @db.UnsignedInt
  checksum String? @db.Char(64)
  storageProvider String @default("LOCAL") @map("storage_provider") @db.VarChar(32)
  storageKey String @unique @map("storage_key") @db.Char(36)
  status FileStatus @default(UPLOADING)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  uploaderMembership OrganizationMembership @relation(fields: [organizationId, uploadedByUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict, map: "file_objects_uploader_membership_fkey")
  taskAttachments TaskAttachment[]
  documentVersions DocumentVersion[]
  aiKnowledgeDocuments AiKnowledgeDocument[]

  @@unique([organizationId, id])
  @@index([organizationId, uploadedByUserId], map: "file_objects_uploader_membership_idx")
  @@map("file_objects")
}

enum FileStatus {
  UPLOADING
  AVAILABLE
  FAILED
  DELETED
}

model AiRequest {
  id String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  provider String @db.VarChar(32)
  model String @db.VarChar(100)
  status AiRequestStatus @default(STARTED)
  requestId String @map("request_id") @db.VarChar(128)
  inputTokens Int? @map("input_tokens") @db.UnsignedInt
  outputTokens Int? @map("output_tokens") @db.UnsignedInt
  latencyMs Int? @map("latency_ms") @db.UnsignedInt
  errorCategory String? @map("error_category") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  completedAt DateTime? @map("completed_at") @db.DateTime(6)
  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict, map: "ai_requests_membership_fkey")

  @@index([organizationId, userId], map: "ai_requests_membership_idx")
  @@index([organizationId, status, createdAt], map: "ai_requests_status_idx")
  @@map("ai_requests")
}

enum AiRequestStatus {
  STARTED
  SUCCEEDED
  FAILED
}

// Explicit proposals only; the model cannot execute this state transition.
model AiTaskDraft {
  id String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  payload Json
  expiresAt DateTime @map("expires_at") @db.DateTime(6)
  committedAt DateTime? @map("committed_at") @db.DateTime(6)
  taskId String? @map("task_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)
  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  task Task? @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  @@index([organizationId, userId, expiresAt])
  @@map("ai_task_drafts")
}

// Opt-in knowledge from non-HR source files. The source is reauthorized on every read.
model AiKnowledgeDocument {
  id String @id @default(uuid()) @db.Char(36)
  organizationId String @map("organization_id") @db.Char(36)
  fileId String @map("file_id") @db.Char(36)
  indexedByUserId String @map("indexed_by_user_id") @db.Char(36)
  sourceChecksum String @map("source_checksum") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(6)
