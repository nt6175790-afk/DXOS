  CERTIFICATE
  TRAINING
  INSURANCE
  DECISION
  HR_RECORD
  OTHER
}

enum DocumentSensitivity {
  NORMAL
  SENSITIVE
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  EXPIRED
}

model EmployeeDocument {
  id             String              @id @default(uuid()) @db.Char(36)
  organizationId String              @map("organization_id") @db.Char(36)
  employeeId     String              @map("employee_id") @db.Char(36)
  title          String              @db.VarChar(200)
  documentNumber String?             @map("document_number") @db.VarChar(100)
  category       DocumentCategory    @default(OTHER)
  sensitivity    DocumentSensitivity @default(NORMAL)
  status         DocumentStatus      @default(ACTIVE)
  issueDate      DateTime?           @map("issue_date") @db.Date
  expiryDate     DateTime?           @map("expiry_date") @db.Date
  notes          String?             @db.VarChar(2000)
  deletedAt      DateTime?           @map("deleted_at") @db.DateTime(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "emp_docs_org_fkey")
  employee       Employee            @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "emp_docs_org_emp_fkey")
  versions       DocumentVersion[]

  @@unique([organizationId, id], map: "emp_docs_org_id_unique")
  @@index([organizationId, employeeId], map: "emp_docs_org_emp_idx")
  @@index([organizationId, category], map: "emp_docs_org_cat_idx")
  @@index([organizationId, status], map: "emp_docs_org_status_idx")
  @@index([organizationId, expiryDate], map: "emp_docs_org_expiry_idx")
  @@map("employee_documents")
}

model DocumentVersion {
  id               String           @id @default(uuid()) @db.Char(36)
  organizationId   String           @map("organization_id") @db.Char(36)
  documentId       String           @map("document_id") @db.Char(36)
  versionNumber    Int              @map("version_number") @db.UnsignedInt
  fileId           String           @map("file_id") @db.Char(36)
  fileName         String           @map("file_name") @db.VarChar(255)
  fileSize         Int              @map("file_size") @db.UnsignedInt
  contentType      String           @map("content_type") @db.VarChar(100)
  checksum         String?          @db.Char(64)
  changeSummary    String?          @map("change_summary") @db.VarChar(1000)
  uploadedByUserId String           @map("uploaded_by_user_id") @db.Char(36)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  document         EmployeeDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "doc_versions_org_doc_fkey")
  file             FileObject       @relation(fields: [organizationId, fileId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "doc_versions_org_file_fkey")

  @@unique([organizationId, id], map: "doc_versions_org_id_unique")
  @@unique([documentId, versionNumber], map: "doc_versions_doc_version_unique")
  @@index([organizationId, documentId], map: "doc_versions_org_doc_idx")
  @@index([organizationId, fileId], map: "doc_versions_org_file_idx")
  @@map("document_versions")
}

model DocumentRequirement {
  id                     String           @id @default(uuid()) @db.Char(36)
  organizationId         String           @map("organization_id") @db.Char(36)
  category               DocumentCategory
  name                   String           @db.VarChar(200)
  description            String?          @db.VarChar(1000)
  isRequired             Boolean          @default(true) @map("is_required")
  applicableDepartmentId String?          @map("applicable_department_id") @db.Char(36)
  createdAt              DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "doc_reqs_org_fkey")
  department             Department?      @relation(fields: [organizationId, applicableDepartmentId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "doc_reqs_org_dept_fkey")

  @@unique([organizationId, id], map: "doc_reqs_org_id_unique")
  @@index([organizationId, category], map: "doc_reqs_org_cat_idx")
  @@map("document_requirements")
}

model AutomationRule {
  id             String                @id @default(uuid()) @db.Char(36)
  organizationId String                @map("organization_id") @db.Char(36)
  name           String                @db.VarChar(200)
  description    String?               @db.VarChar(1000)
  trigger        String                @db.VarChar(100)
  conditions     String                @db.Text
  actions        String                @db.Text
  isActive       Boolean               @default(true) @map("is_active")
  lastRunAt      DateTime?             @map("last_run_at") @db.DateTime(3)
  createdBy      String                @map("created_by") @db.Char(36)
  updatedBy      String?               @map("updated_by") @db.Char(36)
  createdAt      DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.DateTime(3)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "auto_rules_org_fkey")
  executions     AutomationExecution[]

  @@unique([organizationId, id], map: "auto_rules_org_id_unique")
  @@index([organizationId, trigger], map: "auto_rules_org_trigger_idx")
  @@index([organizationId, isActive], map: "auto_rules_org_active_idx")
  @@map("automation_rules")
}

model AutomationExecution {
  id               String          @id @default(uuid()) @db.Char(36)
  organizationId   String          @map("organization_id") @db.Char(36)
  automationRuleId String          @map("automation_rule_id") @db.Char(36)
  event            String          @db.VarChar(100)
  entityType       String?         @map("entity_type") @db.VarChar(50)
  entityId         String?         @map("entity_id") @db.VarChar(100)
  status           String          @db.VarChar(20)
  idempotencyKey   String?         @map("idempotency_key") @db.VarChar(191)
  error            String?         @db.Text
  metadata         String?         @db.Text
  startedAt        DateTime        @default(now()) @map("started_at") @db.DateTime(3)
  completedAt      DateTime?       @map("completed_at") @db.DateTime(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "auto_exec_org_fkey")
  rule             AutomationRule  @relation(fields: [automationRuleId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "auto_exec_rule_fkey")

  @@unique([organizationId, id], map: "auto_exec_org_id_unique")
  @@index([organizationId, automationRuleId], map: "auto_exec_org_rule_idx")
  @@index([organizationId, idempotencyKey], map: "auto_exec_org_idemp_idx")
  @@index([organizationId, status], map: "auto_exec_org_status_idx")
  @@map("automation_executions")
}

model WorkflowDefinition {
  id             String             @id @default(uuid()) @db.Char(36)
  organizationId String             @map("organization_id") @db.Char(36)
  name           String             @db.VarChar(200)
  description    String?            @db.VarChar(1000)
  triggerType    String             @map("trigger_type") @db.VarChar(100)
  steps          String             @db.Text
  isActive       Boolean            @default(true) @map("is_active")
  createdBy      String             @map("created_by") @db.Char(36)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wf_defs_org_fkey")
  instances      WorkflowInstance[]

  @@unique([organizationId, id], map: "wf_defs_org_id_unique")
  @@index([organizationId, triggerType], map: "wf_defs_org_trigger_idx")
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id                   String                  @id @default(uuid()) @db.Char(36)
  organizationId       String                  @map("organization_id") @db.Char(36)
  workflowDefinitionId String                  @map("workflow_definition_id") @db.Char(36)
  title                String                  @db.VarChar(255)
  entityType           String?                 @map("entity_type") @db.VarChar(50)
  entityId             String?                 @map("entity_id") @db.VarChar(100)
  status               String                  @default("RUNNING") @db.VarChar(20)
  currentStepIndex     Int                     @default(0) @map("current_step_index")
  data                 String?                 @db.Text
  ownerUserId          String                  @map("owner_user_id") @db.Char(36)
  startedAt            DateTime                @default(now()) @map("started_at") @db.DateTime(3)
  completedAt          DateTime?               @map("completed_at") @db.DateTime(3)
  createdAt            DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wf_inst_org_fkey")
  definition           WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wf_inst_def_fkey")
  stepExecutions       WorkflowStepExecution[]

  @@unique([organizationId, id], map: "wf_inst_org_id_unique")
  @@index([organizationId, status], map: "wf_inst_org_status_idx")
  @@index([organizationId, workflowDefinitionId], map: "wf_inst_org_def_idx")
  @@map("workflow_instances")
}

model WorkflowStepExecution {
  id                 String           @id @default(uuid()) @db.Char(36)
  organizationId     String           @map("organization_id") @db.Char(36)
  workflowInstanceId String           @map("workflow_instance_id") @db.Char(36)
  stepIndex          Int              @map("step_index")
  stepName           String           @map("step_name") @db.VarChar(200)
  stepType           String           @map("step_type") @db.VarChar(50)
  status             String           @default("PENDING") @db.VarChar(20)
  assignedToUserId   String?          @map("assigned_to_user_id") @db.Char(36)
  actionPayload      String?          @map("action_payload") @db.Text
  resultPayload      String?          @map("result_payload") @db.Text
  comments           String?          @db.Text
  executedAt         DateTime?        @map("executed_at") @db.DateTime(3)
  completedAt        DateTime?        @map("completed_at") @db.DateTime(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wf_steps_org_fkey")
  instance           WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wf_steps_inst_fkey")

  @@unique([organizationId, id], map: "wf_steps_org_id_unique")
  @@index([organizationId, workflowInstanceId], map: "wf_steps_org_inst_idx")
  @@index([organizationId, status], map: "wf_steps_org_status_idx")
  @@map("workflow_step_executions")
}

