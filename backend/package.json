{
  "name": "@dx-os/backend",
  "version": "0.4.0",
  "private": true,
  "description": "DX-OS backend API",
  "main": "dist/main.js",
  "scripts": {
    "test:rbac:mysql": "node scripts/test-rbac-mysql.js",
    "dev": "npm run build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate --schema ../database/schema.prisma",
    "db:validate": "prisma validate --schema ../database/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema ../database/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../database/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema ../database/schema.prisma",
    "db:migration:validate": "node scripts/validate-initial-migration.js",
    "test": "jest --config ../jest.config.cjs --runInBand",
    "test:watch": "jest --config ../jest.config.cjs --watch",
    "lint": "eslint src --max-warnings=0",
    "seed:demo-admin": "tsx scripts/seed-demo-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:demo-roles": "tsx scripts/seed-demo-roles.ts",
    "seed:demo-activity": "tsx scripts/seed-demo-activity.ts",
    "ai:eval": "jest --config ../jest.config.cjs --testRegex 'ai-agent[.]eval[.]ts$' --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "openid-client": "6.8.8",
    "pdfjs-dist": "6.4.299",
    "redis": "5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "license": "Apache-2.0"
}
