{
  "name": "dx-os",
  "version": "0.4.0",
  "private": true,
  "description": "DX-OS — Digital Enterprise Operating System",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.21.1",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "backend"
  ],
  "overrides": {
    "body-parser": "2.4.0",
    "multer": "2.5.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "scripts": {
    "security:resume": "node backend/scripts/resume-local-security.js",
    "demo:init": "node backend/scripts/init-demo-env.js",
    "demo:build": "docker compose --env-file .secrets/demo/compose.env -f backend/deploy/compose.demo.yml build",
    "demo:up": "docker compose --env-file .secrets/demo/compose.env -f backend/deploy/compose.demo.yml up -d --wait --wait-timeout 240",
    "demo:down": "docker compose --env-file .secrets/demo/compose.env -f backend/deploy/compose.demo.yml down",
    "demo:status": "docker compose --env-file .secrets/demo/compose.env -f backend/deploy/compose.demo.yml ps -a",
    "demo:test": "node backend/scripts/test-demo-live.js",
    "dev:backend": "npm --workspace @dx-os/backend run dev",
    "build:backend": "npm --workspace @dx-os/backend run build",
    "test:backend": "jest --config jest.config.cjs --runInBand",
    "lint:backend": "eslint backend/src tests/backend --max-warnings=0",
    "db:generate": "npm --workspace @dx-os/backend run db:generate",
    "db:validate": "npm --workspace @dx-os/backend run db:validate",
    "db:migrate:dev": "npm --workspace @dx-os/backend run db:migrate:dev",
    "db:migrate:deploy": "npm --workspace @dx-os/backend run db:migrate:deploy",
    "db:migrate:status": "npm --workspace @dx-os/backend run db:migrate:status",
    "db:migration:validate": "npm --workspace @dx-os/backend run db:migration:validate",
    "check": "npm run lint:backend && npm run test:backend && npm run build:backend",
    "test": "npm run test:backend",
    "build": "npm run build:backend",
    "demo:refresh": "docker compose --env-file .secrets/demo/compose.env -f backend/deploy/compose.demo.yml run --rm bootstrap node node_modules/tsx/dist/cli.mjs --tsconfig backend/tsconfig.json backend/scripts/demo-container-seed.ts"
  },
  "license": "Apache-2.0"
}
