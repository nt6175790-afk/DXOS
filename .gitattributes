* text=auto
*.png binary
*.jpg binary
*.jpeg binary
*.woff2 binary
*.pdf binary
*.docx binary
# Exclude local and historical working material from git archive.
/outputs export-ignore
/work export-ignore
/.secrets export-ignore
/security-artifacts export-ignore
/docs/project-history export-ignore
/docs/reports export-ignore

# Preserve exact upstream legal evidence bytes and recorded checksums.
licenses/** -text
LICENSE -text
NOTICE -text
*.sh text eol=lf
backend/deploy/clamav/*.conf text eol=lf
